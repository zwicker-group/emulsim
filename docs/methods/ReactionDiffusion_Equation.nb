Cell[CellGroupData[{

Cell["Solve the stationary state equation for 2D droplets", "Subtitle",
 CellChangeTimes->{
  3.83654792536904*^9, {3.836548008340763*^9, 
   3.83654801155645*^9}},ExpressionUUID->"84043f82-ca64-4e70-b072-\
39df160b1fa4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"solI2D", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "r", "]"}], "/.", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Equal]", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "r", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "\[Phi]"}], "}"}], ",", "\"\<Polar\>\""}], 
              "]"}]}], "+", "A", "-", 
            RowBox[{"B", "*", 
             RowBox[{"c", "[", "r", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], 
        ",", "c", ",", "r"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"B", "*", 
      RowBox[{"l", "^", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.836546305601494*^9, {3.836546351409562*^9, 3.836546452791361*^9}, {
   3.836546672194583*^9, 3.836546694883761*^9}, {3.836546741241905*^9, 
   3.836546767594548*^9}, {3.836548104814178*^9, 3.836548108347683*^9}, 
   3.837764523994502*^9, 3.8378426851450233`*^9, 3.837844063998847*^9, {
   3.837844287846896*^9, 3.837844295485901*^9}, {3.8378443481169987`*^9, 
   3.837844350540163*^9}, {3.837844388387579*^9, 3.837844395347266*^9}, 
   3.8378444675240088`*^9, 3.8378445542478*^9, 3.837844989900049*^9, 
   3.837859985772278*^9, {3.837860511041366*^9, 3.837860516129696*^9}, 
   3.838057238243294*^9, 3.838057433955755*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"8dc9a86b-36c6-482e-a37b-7f8066a952cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"\[Pi]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"BesselI", "[", 
        RowBox[{"0", ",", 
         FractionBox[
          RowBox[{"L", "+", "R"}], "l"]}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "A"}], "+", 
            RowBox[{"B", " ", "cEqOut"}]}], ")"}], " ", 
          RowBox[{"BesselY", "[", 
           RowBox[{"0", ",", 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"\[ImaginaryI]", " ", "r"}], "l"]}]}], "]"}]}], "+", 
