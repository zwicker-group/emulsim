Cell[CellGroupData[{

Cell["Solve the stationary state equation for 1D droplets", "Subtitle",
 CellChangeTimes->{
  3.83654792536904*^9, {3.836548008340763*^9, 3.83654801155645*^9}, 
   3.837766823333226*^9},ExpressionUUID->"6ebece00-92d4-4e5a-8dfb-\
5885cc0ca05a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol1D", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "x", "]"}], "/.", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Equal]", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "x", "]"}], ",", 
               RowBox[{"{", "x", "}"}], ",", "\"\<Cartesian\>\""}], "]"}]}], 
            "+", "A", "-", 
            RowBox[{"B", "*", 
             RowBox[{"c", "[", "x", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], 
        ",", "c", ",", "x"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"B", "*", 
      RowBox[{"l", "^", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.837766832908444*^9, 3.83776685895611*^9}, {
   3.837766901650186*^9, 3.837766904443959*^9}, {3.837842659686554*^9, 
   3.83784265991567*^9}, 3.8378445868731413`*^9, {3.837844718332748*^9, 
   3.8378447641966476`*^9}, 3.8378448953710814`*^9, {3.8378449364411573`*^9, 
   3.837844939445524*^9}, {3.837845087687771*^9, 3.8378450911143703`*^9}, {
   3.837846870012068*^9, 3.83784687456149*^9}, 3.837846932319106*^9, {
   3.837859633586226*^9, 3.83785966316086*^9}, {3.837859781924178*^9, 
   3.8378597981777277`*^9}, {3.837860403699553*^9, 3.837860411111847*^9}, 
   3.838057128369142*^9, 3.838057430343442*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"6375f06d-dd28-49c8-a3ed-7c51c0e9691e"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    FractionBox["L", "l"]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"Coth", "[", 
      FractionBox["L", "l"], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", " ", 
      RowBox[{"Sinh", "[", 
       FractionBox["L", "l"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", 
        RowBox[{"B", " ", "cfar"}]}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"R", "-", "x"}], "l"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "A"}], "+", 
        RowBox[{"B", " ", "cEqOut"}]}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"L", "+", "R", "-", "x"}], "l"], "]"}]}]}], ")"}]}], 
  "B"]], "Output",
 CellChangeTimes->{{3.837766878780566*^9, 3.837766908501308*^9}, 
   3.8377674456327877`*^9, 3.837769009667685*^9, {3.837842640670642*^9, 
