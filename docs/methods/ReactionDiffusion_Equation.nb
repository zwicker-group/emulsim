  RowBox[{"4", " ", "Diff", " ", "\[Pi]", " ", "R", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A", "-", 
          RowBox[{"B", " ", "cEqOut"}]}], ")"}], " ", 
