Cell[TextData[StyleBox["It\[CloseCurlyQuote]s a bit weird that the correction \
is proportional to cOut since this is not what corrects our simulations \
empirically (We would expect a correction proportional to c0). It could be \
that the production in the background profile perfectly compensates the \
actual profile inside the droplet (up to an offset, which might scale with \
c0)",
 FontColor->RGBColor[1., 0., 0.]]], "Text",
 CellChangeTimes->{{3.9496592601327*^9, 3.9496593261146793`*^9}, {
  3.949659360014988*^9, 3.9496594386607857`*^9}, {3.949663840319119*^9, 
  3.949663870696665*^9}, {3.9497167887789183`*^9, 3.949716804555523*^9}, {
  3.9497203771212797`*^9, 3.94972041580647*^9}},
 FontSize->20,
 FontWeight->"Bold",ExpressionUUID->"1b92a6ac-6d66-491d-a392-ef2118c29b21"]
}, Open  ]],

