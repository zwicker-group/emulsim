Cell[TextData[StyleBox["Solve the stationary state equation for 1D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.845693825062788*^9, 3.845693825974187*^9}, {3.845694608480123*^9, 
  3.84569460941588*^9}},ExpressionUUID->"a1f88254-da08-43c4-9161-\
b6c6b61815d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol1DInside", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "x", "]"}], "/.", " ", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "==", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "x", "]"}], ",", 
               RowBox[{"{", "x", "}"}], ",", "\"\<Cartesian\>\""}], "]"}]}], 
            "+", "ScZeroIn", "-", 
            RowBox[{"k", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"c", "[", "x", "]"}], "-", "cZeroIn"}], ")"}]}]}]}], 
          ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "1", "]"}], "[", "c", "]"}], "[", "0",
             "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "==", "cEqIn"}]}], "}"}], ",", "c", 
        ",", "x"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"k", "*", 
      RowBox[{"(", 
       RowBox[{"\[Xi]", "^", "2"}], ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
