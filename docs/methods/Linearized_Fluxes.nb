Cell[BoxData[
 RowBox[{
  RowBox[{"solI2DOutside", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "r", "]"}], "/.", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Equal]", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "r", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "\[Phi]"}], "}"}], ",", "\"\<Polar\>\""}], 
              "]"}]}], "+", "A", "-", 
            RowBox[{"k", "*", 
             RowBox[{"c", "[", "r", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], 
        ",", "c", ",", "r"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"k", "*", 
      RowBox[{"\[Xi]", "^", "2"}]}]}]}], "]"}]}]], "Input",
