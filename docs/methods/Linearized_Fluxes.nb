Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 1D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.844487047630419*^9, 
  3.8444870477995577`*^9}},ExpressionUUID->"4b4e6f1b-e32e-486a-807e-\
8a75c6ae024a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol1DOutsidePassive", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c", "[", "x", "]"}], "/.", 
    RowBox[{"First", "@", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "\[Equal]", 
          RowBox[{"Diff", "*", 
           RowBox[{"Laplacian", "[", 
            RowBox[{
             RowBox[{"c", "[", "x", "]"}], ",", 
             RowBox[{"{", "x", "}"}], ",", "\"\<Cartesian\>\""}], "]"}]}]}], 
         ",", 
         RowBox[{
          RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], ",",
        "c", ",", "x"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
