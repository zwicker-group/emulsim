   3.846040346940137*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"a2e8b734-72c8-4b59-949a-123f24fabdad"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"L", "/", "\[Xi]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"Coth", "[", 
      FractionBox["L", "\[Xi]"], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", " ", "r", " ", 
      RowBox[{"Sinh", "[", 
       FractionBox["L", "\[Xi]"], "]"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", 
        RowBox[{"cfar", " ", "k"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"L", "+", "R"}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"r", "-", "R"}], "\[Xi]"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "A"}], "+", 
        RowBox[{"cEqOut", " ", "k"}]}], ")"}], " ", "R", " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"L", "-", "r", "+", "R"}], "\[Xi]"], "]"}]}]}], ")"}]}], 
