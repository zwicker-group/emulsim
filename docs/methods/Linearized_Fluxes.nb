 FractionBox[
  RowBox[{"2", " ", "Diff", " ", "\[Pi]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", 
        RowBox[{"cfar", " ", "k"}]}], ")"}], " ", "\[Xi]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "A"}], "+", 
        RowBox[{"cEqOut", " ", "k"}]}], ")"}], " ", "R", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"BesselI", "[", 
          RowBox[{"1", ",", 
           FractionBox["R", "\[Xi]"]}], "]"}], " ", 
         RowBox[{"BesselK", "[", 
          RowBox[{"0", ",", 
           FractionBox[
            RowBox[{"L", "+", "R"}], "\[Xi]"]}], "]"}]}], "+", 
        RowBox[{
