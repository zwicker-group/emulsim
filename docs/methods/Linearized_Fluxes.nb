Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"Diff", ">", "0"}], "&&", 
    RowBox[{"k", ">", "0"}], "&&", 
    RowBox[{"cZeroIn", ">", "0"}], "&&", 
    RowBox[{"cEqIn", ">", "0"}], "&&", 
    RowBox[{"R", ">", "0"}], "&&", 
