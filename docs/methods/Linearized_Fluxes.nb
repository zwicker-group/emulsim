Cell[TextData[StyleBox["Calculate surface area integrated fluxes at the \
droplet surface",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{
  3.836548090575583*^9, {3.8377678427569933`*^9, 
   3.837767844828073*^9}},ExpressionUUID->"52e5b075-6ad7-490d-8878-\
5986addff14a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FluxOutside2D", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "\[Pi]", "*", "R", "*", "Diff", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"sol2DOutside", "[", "r", "]"}], ",", "r"}], "]"}]}], "/.", 
