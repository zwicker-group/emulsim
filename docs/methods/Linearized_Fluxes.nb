Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 2D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.844489355904442*^9, 
  3.844489356064457*^9}},ExpressionUUID->"fe7c9773-d3ad-4619-99f6-\
c8fe9d42fd2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol2DOutsidePassive", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c", "[", "r", "]"}], "/.", 
    RowBox[{"First", "@", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "\[Equal]", 
          RowBox[{"Diff", "*", 
           RowBox[{"Laplacian", "[", 
            RowBox[{
             RowBox[{"c", "[", "r", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", "\[Phi]"}], "}"}], ",", "\"\<Polar\>\""}], 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], ",",
        "c", ",", "r"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
