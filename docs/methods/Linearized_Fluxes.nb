Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 3D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 
  3.836548028425984*^9}},ExpressionUUID->"571f37b1-44c1-4c3e-99ff-\
c66fcf6c9450"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol3DOutside", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "r", "]"}], "/.", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Equal]", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "r", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "\[Phi]", ",", "\[Theta]"}], "}"}], ",", 
               "\"\<Spherical\>\""}], "]"}]}], "+", "A", "-", 
            RowBox[{"B", "*", 
             RowBox[{"c", "[", "r", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], 
        ",", "c", ",", "r"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"B", "*", 
      RowBox[{"l", "^", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
   3.836548185395409*^9, 3.836548185911302*^9}, {3.837761956983219*^9, 
   3.837761967338525*^9}, {3.837762774383132*^9, 3.8377627960897923`*^9}, 
   3.837763122827433*^9, {3.837763153301153*^9, 3.837763167773724*^9}, {
   3.83776320205507*^9, 3.837763210223415*^9}, {3.837763388489791*^9, 
   3.837763388797266*^9}, 3.837763440364419*^9, 3.837844614322345*^9, {
   3.8378452728499537`*^9, 3.8378452780944653`*^9}, 3.837860088779717*^9, 
   3.837860603273398*^9, 3.8380573395285387`*^9, {3.838057438493476*^9, 
   3.838057445033923*^9}, {3.844485587728302*^9, 3.844485588778908*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"a2e8b734-72c8-4b59-949a-123f24fabdad"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    FractionBox["L", "l"]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"Coth", "[", 
      FractionBox["L", "l"], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", " ", "r", " ", 
      RowBox[{"Sinh", "[", 
       FractionBox["L", "l"], "]"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", 
        RowBox[{"B", " ", "cfar"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"L", "+", "R"}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"r", "-", "R"}], "l"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "A"}], "+", 
        RowBox[{"B", " ", "cEqOut"}]}], ")"}], " ", "R", " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"L", "-", "r", "+", "R"}], "l"], "]"}]}]}], ")"}]}], 
  RowBox[{"B", " ", "r"}]]], "Output",
 CellChangeTimes->{3.844581356870706*^9, 3.84458141463518*^9, 
