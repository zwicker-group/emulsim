Cell[TextData[StyleBox["Solve the stationary state equation for 3D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 
  3.836548028425984*^9}},ExpressionUUID->"67df0934-a6d3-4caa-8b47-\
34847127fd35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol3DInside", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"c", "[", "r", "]"}], "/.", " ", 
      RowBox[{"First", "@", 
       RowBox[{"DSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "==", 
            RowBox[{
             RowBox[{"Diff", "*", 
              RowBox[{"Laplacian", "[", 
               RowBox[{
                RowBox[{"c", "[", "r", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "\[Phi]", ",", "\[Theta]"}], "}"}], ",", 
                "\"\<Spherical\>\""}], "]"}]}], "+", "ScZeroIn", "-", 
             RowBox[{"k", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"c", "[", "r", "]"}], "-", "cZeroIn"}], ")"}]}]}]}], 
           ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "1", "]"}], "[", "c", "]"}], "[", 
             "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"c", "[", "R", "]"}], "==", "cEqIn"}]}], "}"}], ",", "c", 
         ",", "r"}], "]"}]}]}], "]"}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"k", "*", 
      RowBox[{"\[Xi]", "^", "2"}]}]}]}], "]"}]}]], "Input",
