Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 2D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.844489355904442*^9, 
  3.844489356064457*^9}},ExpressionUUID->"7e556b5e-c6a5-4d25-8302-\
18271430faa0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol2DOutsidePassive", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c", "[", "r", "]"}], "/.", 
    RowBox[{"First", "@", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "\[Equal]", 
          RowBox[{"Diff", "*", 
           RowBox[{"Laplacian", "[", 
            RowBox[{
             RowBox[{"c", "[", "r", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", "\[Phi]"}], "}"}], ",", "\"\<Polar\>\""}], 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], ",",
        "c", ",", "r"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
   3.836548185395409*^9, 3.836548185911302*^9}, {3.837761956983219*^9, 
   3.837761967338525*^9}, {3.837762774383132*^9, 3.8377627960897923`*^9}, 
   3.837763122827433*^9, {3.837763153301153*^9, 3.837763167773724*^9}, {
   3.83776320205507*^9, 3.837763210223415*^9}, {3.837763388489791*^9, 
   3.837763388797266*^9}, 3.837763440364419*^9, 3.837844614322345*^9, {
   3.8378452728499537`*^9, 3.8378452780944653`*^9}, 3.837860088779717*^9, 
   3.837860603273398*^9, 3.8380573395285387`*^9, {3.838057438493476*^9, 
   3.838057445033923*^9}, {3.844485587728302*^9, 3.844485588778908*^9}, {
   3.8444884607305927`*^9, 3.8444884835072203`*^9}, {3.844489392806835*^9, 
   3.8444894019852943`*^9}, 3.845697147231413*^9},
 CellLabel->"In[78]:=",ExpressionUUID->"c04d2246-c0c2-48de-9c94-4a72e56f77bb"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"cEqOut", "-", "cfar"}], ")"}], " ", 
    RowBox[{"Log", "[", "r", "]"}]}], "+", 
   RowBox[{"cfar", " ", 
    RowBox[{"Log", "[", "R", "]"}]}], "-", 
   RowBox[{"cEqOut", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"L", "+", "R"}], "]"}]}]}], 
  RowBox[{"Log", "[", 
   FractionBox["R", 
    RowBox[{"L", "+", "R"}]], "]"}]]], "Output",
 CellChangeTimes->CompressedData["
