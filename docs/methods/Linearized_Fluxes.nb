   SuperscriptBox["R", "2"]}], "+", 
  FractionBox[
   RowBox[{"\[Pi]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "cEqOut", " ", "Diff"}], "+", 
