 FractionBox[
  RowBox[{"4", " ", "Diff", " ", "\[Pi]", " ", "R", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A", "-", 
