    RowBox[{"(", 
     RowBox[{"L", "+", "R"}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"L", "-", "r", "+", "R"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"6", " ", "cEqOut", " ", "Diff", " ", "R"}], "+", 
