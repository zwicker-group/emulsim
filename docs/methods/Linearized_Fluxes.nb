Cell[CellGroupData[{

Cell[TextData[StyleBox["Calculate surface area integrated fluxes at the \
droplet surface",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{
  3.836548090575583*^9, {3.8377678427569933`*^9, 
   3.837767844828073*^9}},ExpressionUUID->"ab97ddbf-6869-4acb-b974-\
2fed6fc20f21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FluxOutside2D", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "\[Pi]", "*", "R", "*", "Diff", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"sol2DOutside", "[", "r", "]"}], ",", "r"}], "]"}]}], "/.", 
     RowBox[{"r", "\[Rule]", "R"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8365476665235043`*^9, 3.836547680461857*^9}, {
   3.836548215281542*^9, 3.836548220142315*^9}, {3.837762839878867*^9, 
