 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", "cEqOut", " ", "Diff"}], "-", 
      RowBox[{"4", " ", "cfar", " ", "Diff"}], "-", 
      RowBox[{"A", " ", "L", " ", 
       RowBox[{"(", 
        RowBox[{"L", "+", 
         RowBox[{"2", " ", "R"}]}], ")"}]}]}], ")"}], " ", 
    RowBox[{"Log", "[", "r", "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", "cfar", " ", "Diff"}], "+", 
      RowBox[{"A", " ", 
       RowBox[{"(", 
        RowBox[{"L", "-", "r", "+", "R"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"L", "+", "r", "+", "R"}], ")"}]}]}], ")"}], " ", 
    RowBox[{"Log", "[", "R", "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "cEqOut", " ", "Diff"}], "+", 
      RowBox[{"A", " ", 
       RowBox[{"(", 
        RowBox[{"r", "-", "R"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"r", "+", "R"}], ")"}]}]}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"L", "+", "R"}], "]"}]}]}], 
  RowBox[{"4", " ", "Diff", " ", 
