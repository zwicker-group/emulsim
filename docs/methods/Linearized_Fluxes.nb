Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 3D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 
  3.836548028425984*^9}},ExpressionUUID->"a9dafae6-67d5-4f5e-a3be-\
b597e7efac28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol3DOutside", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c", "[", "r", "]"}], "/.", 
    RowBox[{"First", "@", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "\[Equal]", 
          RowBox[{
           RowBox[{"Diff", "*", 
            RowBox[{"Laplacian", "[", 
             RowBox[{
              RowBox[{"c", "[", "r", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "\[Phi]", ",", "\[Theta]"}], "}"}], ",", 
              "\"\<Spherical\>\""}], "]"}]}], "+", "A"}]}], ",", 
         RowBox[{
          RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], ",",
        "c", ",", "r"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
