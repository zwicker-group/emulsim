Cell[TextData[StyleBox["Solve the stationary state equation for 1D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.844487047630419*^9, 
  3.8444870477995577`*^9}},ExpressionUUID->"1e591d92-eb47-4c16-a1ca-\
aea858087444"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol1DOutside", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "x", "]"}], "/.", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Equal]", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "x", "]"}], ",", 
               RowBox[{"{", "x", "}"}], ",", "\"\<Cartesian\>\""}], "]"}]}], 
            "+", "A", "-", 
            RowBox[{"k", "*", 
             RowBox[{"c", "[", "x", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], 
        ",", "c", ",", "x"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"k", "*", 
      RowBox[{"\[Xi]", "^", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
