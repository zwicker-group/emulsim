Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 2D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.845693825062788*^9, 
  3.845693825974187*^9}},ExpressionUUID->"ceb3344a-940d-4523-bd26-\
440d49b45e4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol2DInside", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"c", "[", "r", "]"}], "/.", " ", 
      RowBox[{"First", "@", 
       RowBox[{"DSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "==", 
            RowBox[{
             RowBox[{"Diff", "*", 
              RowBox[{"Laplacian", "[", 
               RowBox[{
                RowBox[{"c", "[", "r", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "\[Phi]"}], "}"}], ",", "\"\<Polar\>\""}], 
               "]"}]}], "+", "ScZeroIn", "-", 
             RowBox[{"k", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"c", "[", "r", "]"}], "-", "cZeroIn"}], ")"}]}]}]}], 
           ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "1", "]"}], "[", "c", "]"}], "[", 
             "0", "]"}], "==", "0"}], ",", 
