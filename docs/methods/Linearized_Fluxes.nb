Cell[CellGroupData[{

Cell[TextData[StyleBox["Solve the stationary state equation for 1D droplets",
 FontSize->18]], "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 3.836548028425984*^9}, {
  3.844487047630419*^9, 
  3.8444870477995577`*^9}},ExpressionUUID->"554e71d8-e89d-4cd6-a111-\
9a64964a6f67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol1DOutside", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", "x", "]"}], "/.", 
     RowBox[{"First", "@", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Equal]", 
           RowBox[{
            RowBox[{"Diff", "*", 
             RowBox[{"Laplacian", "[", 
              RowBox[{
               RowBox[{"c", "[", "x", "]"}], ",", 
               RowBox[{"{", "x", "}"}], ",", "\"\<Cartesian\>\""}], "]"}]}], 
            "+", "A", "-", 
            RowBox[{"B", "*", 
             RowBox[{"c", "[", "x", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], 
        ",", "c", ",", "x"}], "]"}]}]}], "/.", " ", 
    RowBox[{"Diff", "->", 
     RowBox[{"B", "*", 
      RowBox[{"l", "^", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
   3.836548185395409*^9, 3.836548185911302*^9}, {3.837761956983219*^9, 
   3.837761967338525*^9}, {3.837762774383132*^9, 3.8377627960897923`*^9}, 
   3.837763122827433*^9, {3.837763153301153*^9, 3.837763167773724*^9}, {
   3.83776320205507*^9, 3.837763210223415*^9}, {3.837763388489791*^9, 
   3.837763388797266*^9}, 3.837763440364419*^9, 3.837844614322345*^9, {
   3.8378452728499537`*^9, 3.8378452780944653`*^9}, 3.837860088779717*^9, 
   3.837860603273398*^9, 3.8380573395285387`*^9, {3.838057438493476*^9, 
   3.838057445033923*^9}, {3.844485587728302*^9, 3.844485588778908*^9}, {
   3.844487021253701*^9, 3.8444870342756357`*^9}, {3.844487885985836*^9, 
   3.844487913034683*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"c5c22314-ec8c-49f5-a24a-9f8ae1afacc7"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    FractionBox["L", "l"]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"Coth", "[", 
      FractionBox["L", "l"], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"A", " ", 
      RowBox[{"Sinh", "[", 
       FractionBox["L", "l"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", 
        RowBox[{"B", " ", "cfar"}]}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"R", "-", "x"}], "l"], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "A"}], "+", 
        RowBox[{"B", " ", "cEqOut"}]}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       FractionBox[
        RowBox[{"L", "+", "R", "-", "x"}], "l"], "]"}]}]}], ")"}]}], 
  "B"]], "Output",
 CellChangeTimes->{3.844581355013123*^9, 3.844581394755621*^9, 
