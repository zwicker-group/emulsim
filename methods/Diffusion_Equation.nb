       RowBox[{"6", " ", "cEqOut", " ", "Diff", " ", "R"}], "+", 
       RowBox[{"A", " ", "L", " ", 
        RowBox[{"(", 
         RowBox[{"r", "-", "R"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"L", "+", "r", "+", 
          RowBox[{"2", " ", "R"}]}], ")"}]}]}], ")"}]}]}], ")"}]}]], "Output",\

