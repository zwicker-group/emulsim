5885cc0ca05a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol1D", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c", "[", "x", "]"}], "/.", 
