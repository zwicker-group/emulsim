              RowBox[{"{", "x", "}"}], ",", "\"\<Cartesian\>\""}], "]"}]}], 
           "+", "A"}]}], ",", 
         RowBox[{
          RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], ",",
        "c", ",", "x"}], "]"}]}]}], "]"}]}]], "Input",
