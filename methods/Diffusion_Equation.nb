Cell["Solve the stationary state equation for 3D droplets", "Subtitle",
 CellChangeTimes->{{3.836548026130436*^9, 
  3.836548028425984*^9}},ExpressionUUID->"eedb5845-1b5c-42aa-a45a-\
e56687a374af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol3D", "[", "r_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"c", "[", "r", "]"}], "/.", 
    RowBox[{"First", "@", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "\[Equal]", 
          RowBox[{
           RowBox[{"Diff", "*", 
            RowBox[{"Laplacian", "[", 
             RowBox[{
              RowBox[{"c", "[", "r", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "\[Phi]", ",", "\[Theta]"}], "}"}], ",", 
              "\"\<Spherical\>\""}], "]"}]}], "+", "A"}]}], ",", 
         RowBox[{
          RowBox[{"c", "[", "R", "]"}], "\[Equal]", "cEqOut"}], ",", 
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"R", "+", "L"}], "]"}], "\[Equal]", "cfar"}]}], "}"}], ",",
        "c", ",", "r"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.836547373681745*^9, 3.836547393381256*^9}, 
   3.836547441086907*^9, {3.8365475420423737`*^9, 3.83654755049049*^9}, {
