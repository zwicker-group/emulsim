Cell[CellGroupData[{
Cell["\<\
Linearized fluxes inside shell sector for 1D, 2D and 3D droplets. We solve \
the Diffusion equation with a constant source in the shell sector and check \
for the passive case too.\
\>", "Title",
 CellChangeTimes->{{3.83575834922691*^9, 3.835758349930105*^9}, 
   3.835758821513914*^9, {3.8365472849399147`*^9, 3.836547292435549*^9}, {
